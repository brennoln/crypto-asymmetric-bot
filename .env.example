# --- Modo de execução -------------------------------------------------------
PAPER_TRADING=True

# --- Sizing e risco de portfólio --------------------------------------------
POSITION_SIZE_USD=15.0
MAX_DAILY_LOSS_USD=100.0
MAX_ACTIVE_POSITIONS=10

# --- Fricção Realista de Mercado (v0.3 / v0.5) ------------------------------
ENABLE_PRICE_IMPACT=True
GAS_FEE_USD=0.15
LP_SWAP_FEE_PCT=0.003

# --- Rotação / time-stop ----------------------------------------------------
MAX_HOLD_TIME_MINUTES=20.0
INERTIA_CHECK_MINUTES=10.0
MIN_PROFIT_TO_EXTEND_TIME=0.20
WATCHER_INTERVAL_SEC=4.0

# --- Trailing Stop Dinâmico & Breakeven (v0.4 / v0.5) -----------------------
TRAILING_ACTIVATION_RATIO=1.40
TRAILING_DROP_PRE_2X=0.20
TRAILING_DROP_POST_2X=0.50

ENABLE_BREAKEVEN_PROTECTION=True
BREAKEVEN_ACTIVATION_RATIO=1.15
BREAKEVEN_PULLBACK_DROP=0.15
BREAKEVEN_FLOOR_RATIO=1.02

# --- Detector Invariante Anti-Rug (v0.5) ------------------------------------
ENABLE_INVARIANT_ANTI_RUG=True
MIN_INVARIANT_LIQUIDITY_RATIO=0.85

# --- Auditoria On-Chain & Anti-Cabal (v0.4 / v0.6) --------------------------
ENABLE_RUGCHECK_AUDIT=True
RUGCHECK_API_URL=https://api.rugcheck.xyz/v1/tokens
MAX_RUGCHECK_SCORE=2000
MAX_DEV_HOLDING_PCT=10.0
MAX_SINGLE_HOLDER_PCT=15.0
MAX_TOP10_HOLDERS_PCT=30.0
MAX_INSIDERS_PCT=15.0

# --- Critérios de entrada ---------------------------------------------------
MIN_LIQUIDITY_USD=8000.0
MAX_LIQUIDITY_USD=120000.0
MIN_POOL_AGE_MINUTES=15.0
MAX_POOL_AGE_HOURS=8.0
MIN_VOLUME_M5_USD=1000.0
MIN_BUYS_M5=8
MIN_BUY_SELL_RATIO=1.35
MIN_PRICE_CHANGE_M5_PCT=0.0
MAX_PRICE_CHANGE_M5_PCT=150.0

# --- Travas anti-ruína ------------------------------------------------------
HARD_STOP_LOSS_PCT=0.35
MIN_RUNNING_LIQUIDITY_USD=6000.0

# --- Endpoints --------------------------------------------------------------
# DEXSCREENER_PROFILES_URL=https://api.dexscreener.com/token-profiles/latest/v1
# DEXSCREENER_TOKEN_URL=https://api.dexscreener.com/latest/dex/tokens
